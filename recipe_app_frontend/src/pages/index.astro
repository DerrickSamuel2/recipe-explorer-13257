---
import Layout from '../layouts/Layout.astro';

const recipes = [
  { id: 1, title: 'Spaghetti Bolognese', image: 'https://via.placeholder.com/250x150', description: 'A classic Italian pasta dish.' },
  { id: 2, title: 'Chicken Curry', image: 'https://via.placeholder.com/250x150', description: 'A flavorful curry with tender chicken.' },
  { id: 3, title: 'Veggie Stir-Fry', image: 'https://via.placeholder.com/250x150', description: 'A quick and healthy vegetable stir-fry.' }
];

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<h1>Recipe Explorer</h1>
	<p>Browse delicious recipes below:</p>

	<section class="recipe-grid">
		{recipes.map((recipe) => (
			<article class="recipe-card" key={recipe.id}>
				<img
					class="recipe-image"
					src={recipe.image}
					alt={`Image of ${recipe.title}`}
					width="250"
					height="150"
				/>
				<h2>{recipe.title}</h2>
				<p>{recipe.description}</p>
			</article>
		))}
	</section>
</Layout>

<style>
	.recipe-grid {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		margin-top: 2rem;
	}

	.recipe-card {
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		border-radius: 12px;
		box-shadow: 0 4px 6px var(--shadow-color);
		padding: 1rem;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.recipe-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 6px 10px var(--shadow-hover-color);
	}

	.recipe-image {
		width: 100%;
		height: auto;
		border-radius: 8px;
		object-fit: cover;
		margin-bottom: 0.75rem;
	}
</style>
